# Copy to .env and fill in only the values you need.
# Process environment variables override this file.
# Paths may be absolute, or relative to this repository.

# Optional Hugging Face token. Leave empty for public anonymous downloads.
HF_TOKEN=

# Local base-model directory. Leave empty to download the Hugging Face id in configs/.
EPIPERSONA_MODEL_PATH=

# Defaults are directories inside this repository.
EPIPERSONA_DATA_ROOT=
EPIPERSONA_CACHE_ROOT=
EPIPERSONA_OUTPUT_ROOT=
EPIPERSONA_LOG_ROOT=

# Four device ids. The configs set num_gpus to 4.
EPIPERSONA_GPU_IDS=0,1,2,3

# 1 prints codebook summaries during training.
EPIPERSONA_DEBUG=0
